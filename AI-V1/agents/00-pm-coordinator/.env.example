# Template Environment Utama Hermes Gateway & PM Custodian
# Salin ke /opt/hermes/data/.env (chmod 600, chown 10001:10001)
# JANGAN PERNAH commit file .env asli ke Git!

# Telegram Bot (Hanya dipakai oleh 1 gateway/profil pm-lead)
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_ALLOWED_USERS=<USER_ID_ADMIN_TELEGRAM>
TELEGRAM_HOME_CHANNEL=<CHAT_ID_UTAMA>

# 9Router AI Gateway
NINEROUTER_API_KEY=<NINEROUTER_API_KEY>

# Hermes Dashboard Basic Auth
DASHBOARD_USER=<ADMIN_DASHBOARD_USER>
DASHBOARD_PASSWORD_HASH=<STRONG_PASSWORD_HASH>

# Timezone
TZ=Asia/Jakarta

