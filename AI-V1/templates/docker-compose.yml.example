# Template Docker Compose AI-V1 (Salin ke /opt/hermes/docker-compose.yml)
networks:
  hermes-net:
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.10.0/24
          gateway: 172.28.10.1

services:
  hermes-gateway:
    build:
      context: /opt/hermes/hermes-agent-src
    image: hermes-agent:local
    container_name: hermes-gateway
    restart: unless-stopped
    networks:
      - hermes-net
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      - HERMES_UID=10001
      - HERMES_GID=10001
      - TZ=Asia/Jakarta
    volumes:
      - /opt/hermes/data:/opt/data
      - /home/project:/workspace
      - /var/backups/apps:/opt/data/backups/apps:ro
      - /opt/hermes/ssh:/home/hermes/.ssh:ro
    mem_limit: 1200m
    cpus: "1.2"
    healthcheck:
      test: ["CMD-SHELL", "test -S /opt/data/gateway.sock"]
      interval: 30s
      timeout: 5s
      retries: 3
    command: ["gateway", "run"]

  hermes-dashboard:
    image: hermes-agent:local
    container_name: hermes-dashboard
    restart: unless-stopped
    depends_on:
      hermes-gateway:
        condition: service_healthy
    networks:
      - hermes-net
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "127.0.0.1:9119:9119"
    environment:
      - HERMES_UID=10001
      - HERMES_GID=10001
      - TZ=Asia/Jakarta
    volumes:
      - /opt/hermes/data:/opt/data
      - /home/project:/workspace
    mem_limit: 512m
    cpus: "0.6"
    healthcheck:
      test: ["CMD-SHELL", "python3 -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:9119/login', timeout=3)\""]
      interval: 30s
      timeout: 5s
      retries: 3
    command: ["dashboard", "--host", "0.0.0.0", "--no-open"]

